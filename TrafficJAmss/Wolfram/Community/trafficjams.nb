Cell[CellGroupData[{

Cell["6. A stochastic cellular automaton: Nagel-Schreckenberg", "Section",ExpressionUUID->"2436fbf2-03ba-4058-9cdf-6cb8f5667515"],

Cell[TextData[{
 "IDM and Bando are ODEs; a lot can be simplified by going fully discrete. \
Nagel and Schreckenberg (1992) proposed the minimal CA that still reproduces \
realistic traffic dynamics. Space is discretised into 7.5 m cells (one car \
length), time into 1 s steps, velocity into an integer in [0, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "max"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "c9e42192-292e-44ca-8e87-617b443b3e93"],
 "]. At each step every vehicle applies four rules:"
}], "Text",ExpressionUUID->"88d31e56-4016-476e-8c6e-a9cf5e703f5d"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "1", ")", " ", 
   RowBox[{"accelerate", ":"}], " ", "v", "\[Rule]", 
   RowBox[{"min", "(", 
    RowBox[{"v", "+", "1"}], ",", " ", 
    SubscriptBox["v", "max"], ")"}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"0353882d-9187-4a82-94fb-dd3e5037f553"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "2", ")", " ", 
   RowBox[{"brake", ":"}], " ", "v", "\[Rule]", 
   RowBox[{"min", "(", "v", ",", " ", 
    RowBox[{"d", "-", "1"}], ")"}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"07ee4eaf-2f30-46e9-a290-2abb7bcedceb"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "3", ")", " ", 
   RowBox[{"randomise", ":"}], " ", 
   RowBox[{"with", " ", "probability", " ", "p"}], ",", " ", "v", "\[Rule]", 
   RowBox[{"max", "(", 
    RowBox[{"v", "-", "1"}], ",", " ", "0", ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"08443d15-14c4-46ae-8a50-b0727c491c9d"],

Cell[BoxData[
 FormBox[
  RowBox[{"(", "4", ")", " ", 
   RowBox[{"move", ":"}], " ", "x", "\[Rule]", 
   RowBox[{"x", "+", "v"}]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"010d8b94-5abd-4500-8da4-504a25dfba33"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "321ec89e-b1eb-42e3-9283-0d372122be83"],
 " is the number of empty cells to the next vehicle. Rule 3 is the crucial \
ingredient \[LongDash] without it (set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", 
    RowBox[{"=", "0"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "9b018c25-4f85-45f9-932e-5f38fc7d6a23"],
 "), NaSch reduces to the ",
 StyleBox["asymmetric simple exclusion process (ASEP)",
  FontSlant->Italic],
 " and the steady state is boring: either uniformly dense or uniformly \
sparse. The random slowdown breaks that degeneracy and spontaneously \
nucleates jams. NaSch is the cellular cousin of IDM/OVM: same stop-and-go \
physics, same backward-propagating waves, from four lines of integer \
arithmetic per car per step. It scales to millions of vehicles easily, which \
is why real urban microsimulators (MATSim, SUMO) use CA or CA-like rules \
internally."
}], "Text",ExpressionUUID->"d5511d21-21b7-4ff6-9a34-a91d6c0c3292"],

Cell[CellGroupData[{

Cell["\<\
nsRes = NagelSchreckenberg`SimulateNaSch[
  \"T\" -> 300, \"nVehicles\" -> 80, \"roadLength\" -> 300];
nsFrames = Table[
  CoreAnimations`NaSchHighwayFrame[nsRes, t],
  {t, 1, nsRes[\"T\"], 5}];
ListAnimate[nsFrames, AnimationRate -> 2]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"721f9979-53bb-4186-aa3f-6fecfe819a9b"],

