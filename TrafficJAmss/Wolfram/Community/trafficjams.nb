Cell[TextData[{
 "The ",
 StyleBox["full-city v2 simulation",
  FontWeight->Bold],
 " (",
 StyleBox["AberdeenFullCity.wl", "Input"],
 ") scales this up to the whole council area \[LongDash] an 8.9 MB extract \
with 11,925 drivable nodes after strongly-connected-component restriction. On \
top of IDM car-following it adds 151 OSM-tagged signalised junctions (the \
signal controller from Section 8), ~1000 roundabout-tagged edges with TRL\
\[ThinSpace]281 gap-acceptance yield, a hierarchy-weighted routing (motorway \
factor 0.5, residential 1.2), staggered spawn, and a 10% probabilistic detour \
at each junction. Six hundred agents, six minutes of simulated time, ~30 s \
wall time:"
}], "Text",ExpressionUUID->"fabec6aa-229f-450a-997d-98d06dc65f20"],

