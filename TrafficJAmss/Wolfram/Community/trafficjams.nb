          FEPrivate`FrontEndResource["FEBitmaps", "PauseButtonLargeHover"][
          Automatic]], ImageSize -> 40], Image`InteractiveDump`play$$ === 
        False, 
        PaneBox[
         DynamicBox[
          FEPrivate`FrontEndResource["FEBitmaps", "PlayButtonLarge"][
          Automatic]], ImageSize -> 40], True, ""],
       ImageSizeCache->{4., {0., 0.}}],
      Alignment->Center,
      ImageSize->{266, 340}]}],
    EventHandlerTag[{{"MouseClicked", 1} :> 
      FEPrivate`Set[Image`InteractiveDump`play$$, 
        Not[Image`InteractiveDump`play$$]], "MouseEntered" :> 
      FEPrivate`Set[Image`InteractiveDump`hover$$, True], "MouseExited" :> 
      FEPrivate`Set[Image`InteractiveDump`hover$$, False], Method -> 
      "Preemptive", PassEventsDown -> Automatic, PassEventsUp -> True}]],
   BaseStyle->{ContextMenu -> {
       MenuItem["Play/Pause", 
        KernelExecute[
        Image`InteractiveDump`play$$ = Not[Image`InteractiveDump`play$$]], 
        MenuEvaluator -> Automatic], 
       MenuItem["Stop", 
        KernelExecute[
        Image`InteractiveDump`play$$ = False; Image`Utilities`i$$ = 1], 
        MenuEvaluator -> Automatic], Delimiter, 
       Menu["Frame Rate", {
         MenuItem["8", 
          KernelExecute[Image`InteractiveDump`rate$$ = 8], MenuEvaluator -> 
          Automatic], 
         MenuItem["16", 
          KernelExecute[Image`InteractiveDump`rate$$ = 16], MenuEvaluator -> 
          Automatic], 
         MenuItem["24", 
          KernelExecute[Image`InteractiveDump`rate$$ = 24], MenuEvaluator -> 
          Automatic], 
         MenuItem["30", 
          KernelExecute[Image`InteractiveDump`rate$$ = 30], MenuEvaluator -> 
          Automatic], 
         MenuItem["50", 
          KernelExecute[Image`InteractiveDump`rate$$ = 50], MenuEvaluator -> 
          Automatic], 
         MenuItem["60", 
          KernelExecute[Image`InteractiveDump`rate$$ = 60], MenuEvaluator -> 
          Automatic]}]}, Selectable -> False},
   DynamicModuleValues:>{}],
  BoxForm`AnimatedImageTag[
  FrameRate -> 4, AnimationRunning -> True, AnimationRepetitions -> 
   DirectedInfinity[1]]]], "Output",
 CellMargins->{{20, 20}, {10, 14}},
 ShowCellLabel->False,
 TextAlignment->Center,ExpressionUUID->"60580cf2-3727-402e-9a2b-7d51d75c0c01"]
}, Open  ]],

Cell[TextData[{
 "Linear-stability analysis of the homogeneous solution yields a \
string-stability criterion: uniform flow is linearly unstable when the slope \
of the fundamental diagram exceeds a threshold involving ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "76239519-7958-49b2-b43d-ec0f769ad66f"],
 ", ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "318b5d67-9e12-4265-914e-467936fd0af8"],
 " and ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "94f06c9b-78d7-4f61-81a4-99bb86ca5598"],
 ". The pre-rendered run sits comfortably on the unstable side of that \
criterion, which is why the small ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "\[Rule]", "v", "/", "2"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "b4b11c2e-0fc0-425c-a223-6fa4cfff3604"],
 " kick does not decay. Empirically, stop-and-go jam fronts on real motorways \
propagate upstream at 5\[Dash]7 m/s essentially independent of the inflow \
\[LongDash] IDM reproduces this number from first principles with no further \
tuning."
}], "Text",ExpressionUUID->"be5ff269-fe69-48b5-957d-5af20e509879"],

Cell[TextData[{
 "Sugiyama et al. (2008) reproduced exactly this experiment with real drivers \
on a real circular track. The jam formed spontaneously, propagated backward, \
and persisted as long as the experiment ran. Their video is highly \
recommended alongside the simulation: ",
 ButtonBox["youtube.com/watch?v=Rryu85BtALM",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.youtube.com/watch?v=Rryu85BtALM"], None}],
 ". The match with our run is qualitative rather than bit-exact, but the same \
jam-formation mechanism, the same backward propagation, and the same \
insensitivity to the specific perturbation all show up in the real-world data."
}], "Text",ExpressionUUID->"93f6584b-72df-4057-803e-5e8116d9f7b7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. The simplest car-following that jams: Bando OVM", "Section",ExpressionUUID->"04d5fe04-7f75-4bb3-9bcf-bbb196a435d1"],

Cell[TextData[{
 "IDM has seven parameters and a velocity-difference term. Bando et al. \
(1995) asked how much of this is necessary to get phantom jams and answered: \
none of it. Their Optimal Velocity Model relaxes speed towards a target \
velocity that depends ",
 StyleBox["only",
  FontSlant->Italic],
 " on the current gap to the vehicle ahead:"
}], "Text",ExpressionUUID->"cfa241ad-d4c8-4d99-a45b-4a8740aab204"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox[
    SubscriptBox["v", "\[Alpha]"], "\[CenterDot]"], "=", 
   RowBox[{"\[Kappa]", " ", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["V", "opt"], "(", 
      SubscriptBox["s", "\[Alpha]"], ")", "-", 
      SubscriptBox["v", "\[Alpha]"]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"8f6dadc0-99e9-4d09-b333-df8891d23757"],

Cell["with the standard sigmoidal optimal-velocity function", "Text",ExpressionUUID->"0d03b5cc-6ff3-469f-a04b-e866179de836"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "opt"], "(", "s", ")"}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["v", "max"], "\[ThinSpace]", 
     RowBox[{"(", 
      RowBox[{"tanh", "(", 
       RowBox[{
        FractionBox["s", 
         SubscriptBox["s", "c"]], "-", "2"}], ")"}], "+", 
      RowBox[{"tanh", "(", "2", ")"}], ")"}]}], 
    RowBox[{"1", "+", 
     RowBox[{"tanh", "(", "2", ")"}]}]]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"b2cbf8bc-f84f-4cfc-bdab-b3e197aa3355"],

Cell[TextData[{
 "This is three parameters total \[LongDash] ",
 Cell[BoxData[
  FormBox["\[Kappa]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "b2e8c5f1-8dcd-4876-b2f6-aa2bd09dc2b3"],
 " (sensitivity), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "max"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "e03e14be-e920-4523-837f-2ae57c669cba"],
 " (free-flow speed), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "c"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "f7763626-7691-426d-ab15-cde110f79a96"],
 " (crossover gap) \[LongDash] and no reaction to the rate of approach. \
Linear-stability analysis of the uniform-flow fixed point gives a clean \
criterion: the solution is stable exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox["V", "opt"], 
    RowBox[{"'", "("}], 
    RowBox[{"s", "*"}], ")", "\[LessEqual]", "\[Kappa]"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "9e765dc5-0606-42c8-a14e-5b4e57c27f1a"],
 ". Cross that line and a ",
 StyleBox["Hopf bifurcation",
  FontSlant->Italic],
 " kicks in \[LongDash] the uniform solution loses stability and the system \
collapses onto a limit cycle, which on the ring appears as a rotating \
stop-and-go wave. This is arguably the cleanest mathematical explanation for \
why phantom jams exist at all: they are the attractor of a dynamical \
bifurcation."
}], "Text",ExpressionUUID->"c0902d3b-bd54-4755-b56b-6c675c20c059"],

Cell[TextData[{
 "Bando OVM does have a real weakness: with no velocity-difference term, a \
fast car can drive straight into a slow one if the parameters are wrong. The \
successor Full Velocity Difference model (Jiang et al. 2001) adds exactly \
that term, which is effectively IDM's approach-rate piece. IDM, OVM, and FVD \
form a family: increasing physical realism, increasing parameter count, same \
emergent behaviour. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", 
    RowBox[{"=", "0.4"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "704661f9-7d2f-4c92-9826-15e76631eece"],
 " on an 800 m ring of 18 vehicles we sit firmly below the stability \
threshold, and the Hopf instability grows over the 2000 s run:"
}], "Text",ExpressionUUID->"c2888243-423e-42bb-8051-5b24081ec829"],

Cell[CellGroupData[{

Cell["\<\
bandoRes = Bando`SimulateBando[
  \"nVehicles\" -> 18, \"T\" -> 2000.0,
  \"roadLength\" -> 800.0, \"kappa\" -> 0.4];
bandoFrames = Table[
  CoreAnimations`BandoRingFrame[bandoRes, k, 12],
  {k, 1, Length[bandoRes[\"times\"]], 5}];
ListAnimate[bandoFrames, AnimationRate -> 4]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"0343270d-65f0-4946-a284-fb43c3aca534"],

