Cell["\<\
Payne\[Dash]Whitham has a well-known pathology \[LongDash] Daganzo's (1995) \
\"Requiem for second-order models\" showed it can produce information \
travelling backward faster than any car (cars effectively react to \
information from behind). Modern second-order models (ARZ, GKT) fix this by \
making the pressure anisotropic: drivers respond only to what's in front. We \
keep PW here because it's the textbook second-order PDE and the fix is an \
exercise in swapping the sign on one spatial derivative \[LongDash] the \
qualitative stop-and-go story is already visible.\
\>", "Text",ExpressionUUID->"b0727622-6542-41ea-b8ed-9569b803965d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. The microscopic view: Intelligent Driver Model", "Section",ExpressionUUID->"f4de5fec-9ba2-4a15-b10c-1111704833f8"],

Cell["\<\
Zooming all the way in to an individual vehicle, the Intelligent Driver Model \
(Treiber, Hennecke & Helbing, 2000) is a second-order ODE for the \
longitudinal dynamics:\
\>", "Text",ExpressionUUID->"f50787e4-5f66-4e40-804f-50926e6dd875"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox[
    SubscriptBox["v", "\[Alpha]"], "\[CenterDot]"], "=", 
   RowBox[{"a", " ", 
    RowBox[{"[", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         SubscriptBox["v", "\[Alpha]"], 
         SubscriptBox["v", "0"]], ")"}], "\[Delta]"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["s", "*"], "(", 
          SubscriptBox["v", "\[Alpha]"], ",", " ", 
          RowBox[{"\[CapitalDelta]", 
           SubscriptBox["v", "\[Alpha]"]}], ")"}], 
         SubscriptBox["s", "\[Alpha]"]], ")"}], "2"]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"92445741-edbc-4fe8-9485-c105a3476aee"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "f009b74d-908f-4f64-a6da-7b6881d82f96"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "25468a6a-4b0b-4ad2-b7ae-9b2d405e527b"],
 " are the speed and gap to the vehicle in front, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubscriptBox["v", "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "63efd82e-652f-497d-89d9-95240f700953"],
 " is the approach rate, and the desired gap is"
}], "Text",ExpressionUUID->"8d738026-af7d-4459-8dda-3adff7b1dd01"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["s", "*"], "(", "v", ",", " ", "\[CapitalDelta]v", ")"}], "=", 
   RowBox[{
    SubscriptBox["s", "0"], "+", 
    RowBox[{"v", "\[ThinSpace]", "T"}], "+", 
    FractionBox[
     RowBox[{"v", "\[ThinSpace]", "\[CapitalDelta]v"}], 
     RowBox[{"2", 
      SqrtBox[
       RowBox[{"a", "\[ThinSpace]", "b"}]]}]]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"0874a651-b787-41cf-af59-074d993580f8"],

Cell[TextData[{
 "Each parameter has a direct physical meaning that a traffic engineer can \
calibrate to local data: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "f7e004f0-d675-4f0b-bdac-1db993c5aec5"],
 " is the desired free-flow speed, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "748e1f65-6ab8-40d8-bb0d-25cf2d2149bd"],
 " the minimum bumper gap at standstill (for real drivers ~2 m), ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "ac51a0d3-d319-4f55-83ca-8d8c904a091b"],
 " the safe time headway (UK typical 1.5\[Dash]2 s), ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "fbfde3ac-aa5f-4edc-9026-0f133de82f8a"],
 " and ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "9006a0d8-c691-4d87-b71b-a810ff0dd2ca"],
 " the comfortable acceleration and braking. Crucially, the \
velocity-difference term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "\[CenterDot]", "\[CapitalDelta]v", 
    RowBox[{"/", "("}], 
    RowBox[{"2", 
     SqrtBox[
      RowBox[{"a", "\[CenterDot]", "b"}]]}], ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "7d68e086-44e4-4343-80da-4698e67b4974"],
 " in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "*"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "1fa161c9-e767-4365-a824-199fdabdfb76"],
 " makes IDM collision-free \[LongDash] unlike its ancestor Bando OVM, IDM \
responds to the ",
 StyleBox["rate of approach",
  FontSlant->Italic],
 " rather than just the current gap, so a fast car approaching a slower one \
in front starts braking in time. This is the same principle car-makers build \
into modern adaptive cruise control."
}], "Text",ExpressionUUID->"7509f45a-74bf-457b-a12e-2b8a0e37502f"],

Cell[TextData[{
 "The parameters below put the system firmly in the stop-and-go regime: a \
25-vehicle 1 km ring with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], 
    RowBox[{"=", "30"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "e1ba8079-7851-4395-ba06-88a986cbe756"],
 " m/s desired speed, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", 
    RowBox[{"=", "2.5"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "247d0293-e3b3-45b1-8262-187a9d52e788"],
 " s headway, sluggish acceleration ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", 
    RowBox[{"=", "0.3"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "51c83145-7769-44cb-ae8d-35d1b80fdc77"],
 " m/",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "00b75bbf-4d3e-43bb-84ff-cd1acb07c90f"],
 " and firm braking ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", 
    RowBox[{"=", "2.0"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "c6370c5b-e31b-426a-858e-70396365c873"],
 " m/",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "5e77b8b7-f53e-4475-a47f-e81fab6a25b1"],
 ". One vehicle starts at half speed; the instability amplifies into a \
persistent backward-propagating jam."
}], "Text",ExpressionUUID->"ecb4e2d4-0fa4-4c34-8046-8760e2e91fa3"],

Cell[CellGroupData[{

Cell["\<\
idmRes = IDM`SimulateIDM[
  \"nVehicles\" -> 25, \"T\" -> 400.0, \"roadLength\" -> 1000.0,
  \"v0\" -> 30.0, \"s0\" -> 2.0, \"THeadway\" -> 2.5,
  \"a\" -> 0.3, \"b\" -> 2.0];
idmFrames = Table[
  CoreAnimations`IDMRingFrame[idmRes, k, 20],
  {k, 1, Length[idmRes[\"times\"]], 5}];
ListAnimate[idmFrames, AnimationRate -> 4]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"577914ac-a1c3-443e-9aa7-bd2f7e7a5280"],

