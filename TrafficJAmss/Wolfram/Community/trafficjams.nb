Cell["\<\
The signal controller itself \[LongDash] UK-standard 90 s cycle, 4 s amber \
intergreen, round-robin approach phases \[LongDash] is a few lines of \
data-driven code:\
\>", "Text",ExpressionUUID->"d5779798-b928-43b6-80d0-fb60b90634de"],

Cell[CellGroupData[{

Cell["\<\
icRes = IntersectionControl`SimulateSignalDemo[];
IntersectionControl`PlotSignalDemo[icRes]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"4e5efb24-2f2f-480e-8b94-c81187f82a7b"],

