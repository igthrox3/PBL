Cell[CellGroupData[{

Cell["3. Adding a second equation: Payne-Whitham", "Section",ExpressionUUID->"2f756391-2dc0-4e6f-88fe-f84e83e0c488"],

Cell[TextData[{
 "LWR has an obvious shortcoming: velocity is always the equilibrium value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "(", "\[Rho]", ")"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "cd5faa4c-b114-463d-821e-72f294234a50"],
 " on the fundamental diagram, which implicitly assumes drivers adapt \
infinitely fast. Real drivers take a second or two to react, and they \
anticipate the state of traffic downstream. Payne (1971) and Whitham (1974) \
independently added a momentum equation to capture both effects: velocity \
relaxes towards equilibrium with time constant ",
 Cell[BoxData[
  FormBox["\[Tau]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "2d1cba4f-ce19-48a3-9d35-79b54f51f4de"],
 " (reaction) and is pushed by a pressure-like anticipation term ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["c", "0"], "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "198a38a3-9118-4010-965d-e57152a12a59"],
 ":"
}], "Text",ExpressionUUID->"1522c13a-2536-4b86-835d-ec601666852c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "v"}], 
     RowBox[{"\[PartialD]", "t"}]], "+", "v", 
    FractionBox[
     RowBox[{"\[PartialD]", "v"}], 
     RowBox[{"\[PartialD]", "x"}]]}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{
      SubscriptBox["V", "e"], "(", "\[Rho]", ")"}], "-", "v"}], "\[Tau]"], "-", 
   FractionBox[
    SuperscriptBox[
     SubscriptBox["c", "0"], "2"], "\[Rho]"], 
   FractionBox[
    RowBox[{"\[PartialD]", "\[Rho]"}], 
    RowBox[{"\[PartialD]", "x"}]]}], TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"a1d7f92c-ec07-4807-a0d5-13139beb545c"],

Cell[TextData[{
 "The system is now second-order hyperbolic: two characteristic speeds, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "\[PlusMinus]", 
    SubscriptBox["c", "0"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "b1d18a66-36dc-4c76-8d82-613cb657dce1"],
 ", generalising the single LWR characteristic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "'"}], "(", "\[Rho]", ")"}], TraditionalForm]], 
  "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "300a85fc-02b0-4c43-bc68-1bcba788e92d"],
 ". With the extra degree of freedom the density can be temporarily out of \
equilibrium, which is exactly what produces the stop-and-go oscillations seen \
on real motorways near merges."
}], "Text",ExpressionUUID->"676b7ca5-e208-4e88-b73c-2420e86e5b8a"],

Cell[CellGroupData[{

Cell["\<\
pwRes = PayneWhitham`SimulatePW[];
pwFrames = Table[CoreAnimations`PWCorridorFrame[pwRes, k],
  {k, 1, Length[pwRes[\"t\"]], 2}];
ListAnimate[pwFrames, AnimationRate -> 4]\
\>", "Input",
 CellTags->"runnable",ExpressionUUID->"ca68b3d2-f719-44e4-9d80-d7643491ee24"],

